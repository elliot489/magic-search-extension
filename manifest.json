{
  "manifest_version": 3,
  "name": "Magic Search for Maximo",
  "version": "0.1.0",
  "description": "Command palette for Maximo Manage: open any of your apps by name or alias. Press Cmd+K (Ctrl+K on Windows); configurable.",
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "include_globs": [
        "*maximo/oslc/graphite/manage-shell*"
      ],
      "js": [
        "src/shortcut.js",
        "src/apps.js",
        "src/catalog.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
