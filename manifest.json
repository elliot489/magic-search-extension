{
  "manifest_version": 3,
  "name": "Magic Search for Maximo",
  "version": "0.1.0",
  "description": "Command palette style search for Maximo Manage. Press Ctrl+Space to open.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "include_globs": ["*maximo/oslc/graphite/manage-shell*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
